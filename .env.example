# ==============================================================================
# CUSTOM MAGAZINE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Every external service variable is optional in local development.
# When external credentials are omitted, the app automatically falls back to
# local/mock adapters (embedded PGlite Postgres, LocalDiskStorage, ConsoleMailer).

# ------------------------------------------------------------------------------
# 1. APPLICATION & DATABASE
# ------------------------------------------------------------------------------
# Public URL of the deployed application (supports NEXT_APP_URL or NEXT_PUBLIC_APP_URL)
NEXT_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL connection string for Neon Lakebase Postgres.
# Leave empty in local development to use the automatic embedded PGlite database at ./.local-db
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""
NEON_BRANCH="production"

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION & NOTIFICATIONS
# ------------------------------------------------------------------------------
# Random secret used to sign session tokens (generate with `openssl rand -hex 32`)
AUTH_SECRET="dev-secret-change-in-production-at-least-32-chars"

# Comma-separated list of admin email addresses allowed to access /admin
# Order completion alerts CC all additional emails listed here
ADMIN_EMAILS="princemumo80@gmail.com,barbaratrizer60@gmail.com"

# Shared password required alongside an email in ADMIN_EMAILS to sign into /admin
ADMIN_PASSWORD="admin123"

# Primary admin email that receives order completion alerts and system issue alerts
ADMIN_NOTIFY_EMAIL="princemumo80@gmail.com"

# ------------------------------------------------------------------------------
# 3. GOOGLE DRIVE PHOTO STORAGE
# ------------------------------------------------------------------------------
# OAuth 2.0 Client ID and Secret from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Stored OAuth refresh token obtained by running `npm run drive:auth`
GOOGLE_DRIVE_REFRESH_TOKEN=""

# ID of the root Google Drive folder where per-order folders ("{Her full name} - {order reference}") are created
DRIVE_ROOT_FOLDER_ID=""

# ------------------------------------------------------------------------------
# 4. EMAIL (Resend)
# ------------------------------------------------------------------------------
# Resend API key (if empty, uses ConsoleMailer which logs to terminal and saves to dev_outbox table)
RESEND_API_KEY=""

# Verified sender email address in Resend
MAIL_FROM="Custom Magazine <noreply@cleanplay.app>"
