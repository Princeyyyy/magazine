# ==============================================================================
# HER CUSTOM MAGAZINE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Every external service variable is optional in local development!
# When external credentials are omitted, the app automatically falls back to
# local/mock adapters (embedded PGlite Postgres, LocalDiskStorage, ConsoleMailer,
# WhatsAppLinkProvider, ConsoleAdminNotifier) and shows a "Dev Mode" badge in Admin.

# ------------------------------------------------------------------------------
# 1. APPLICATION & DATABASE
# ------------------------------------------------------------------------------
# Public URL of the deployed application (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# PostgreSQL connection string for Neon or Supabase (recommended for Vercel).
# Leave empty in local development to use the automatic embedded PGlite PostgreSQL database at ./.local-db
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 2. ADMIN AUTHENTICATION (Auth.js / NextAuth)
# ------------------------------------------------------------------------------
# Random secret used to encrypt session tokens (generate with `npx auth secret` or `openssl rand -base64 32`)
AUTH_SECRET="dev-secret-change-in-production-at-least-32-chars"

# Google OAuth credentials for Admin sign-in (leave empty in local dev to enable Dev Admin sign-in)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated list of admin email addresses allowed to access /admin
ADMIN_EMAILS="admin@example.com"

# Shared password required alongside an email in ADMIN_EMAILS to sign into /admin
ADMIN_PASSWORD="admin123"

# Email address that receives new-order alerts from AdminNotifier
ADMIN_NOTIFY_EMAIL="admin@example.com"

# ------------------------------------------------------------------------------
# 3. GOOGLE DRIVE PHOTO STORAGE
# ------------------------------------------------------------------------------
# OAuth 2.0 Client ID and Secret from Google Cloud Console (for personal Drive storage via refresh token)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Stored OAuth refresh token obtained by running `npm run drive:auth`
# IMPORTANT: Ensure your Google OAuth Consent Screen is set to "In production" so this token does not expire after 7 days.
GOOGLE_DRIVE_REFRESH_TOKEN=""

# ID of the root Google Drive folder where per-order folders ("{Her full name} - {order reference}") will be created
DRIVE_ROOT_FOLDER_ID=""

# ------------------------------------------------------------------------------
# 4. EMAIL (Resend)
# ------------------------------------------------------------------------------
# Resend API key (if empty, uses ConsoleMailer which logs to terminal and saves to dev_outbox table)
RESEND_API_KEY=""

# Sender email address in Resend (use onboarding@resend.dev if you do not have a custom domain yet)
MAIL_FROM="Custom Magazine <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 5. WHATSAPP
# ------------------------------------------------------------------------------
# Your business WhatsApp phone number in international digits without '+' (used by WhatsAppLinkProvider for wa.me links)
WHATSAPP_NUMBER="254700000000"

# Set to "true" to enable automated messages via Meta WhatsApp Cloud API instead of wa.me links
WHATSAPP_CLOUD_ENABLED="false"

# Meta WhatsApp Cloud API Phone Number ID (required if WHATSAPP_CLOUD_ENABLED="true")
WHATSAPP_PHONE_NUMBER_ID=""

# Meta WhatsApp Cloud API Permanent Access Token (required if WHATSAPP_CLOUD_ENABLED="true")
WHATSAPP_ACCESS_TOKEN=""

# Approved WhatsApp message template name in Meta Business Suite (e.g., "order_status_update")
WHATSAPP_TEMPLATE_NAME="order_status_update"

# ------------------------------------------------------------------------------
# 6. OPTIONAL TELEGRAM ADMIN NOTIFIER
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather (optional secondary alert channel for new orders)
TELEGRAM_BOT_TOKEN=""

# Telegram Chat ID to send new order notifications to
TELEGRAM_CHAT_ID=""

# ------------------------------------------------------------------------------
# 7. ABUSE PROTECTION (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# Cloudflare Turnstile site key and secret key (optional; skipped if empty)
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
